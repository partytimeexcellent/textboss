# Port the web server listens on. With Docker Compose this is the host port
# your reverse proxy connects to (the app uses 3000 inside the container).
PORT=3000

# Domain Caddy serves and gets an HTTPS certificate for
# (only with `docker compose --profile caddy`; ignore when using Pangolin etc.)
DOMAIN=sms.example.com

# Public HTTPS base URL of this server, with no trailing slash.
# BulkVS must be able to reach it for inbound webhooks, and MMS attachments
# you send are served from here so carriers can fetch them.
PUBLIC_URL=https://sms.example.com

# Where the SQLite database and uploaded media are stored
DATA_DIR=./data

# Watched folder: .xls/.xlsx/.csv contact exports saved here are imported
# automatically, then moved to processed/ or failed/. Defaults to DATA_DIR/import.
# (Docker Compose sets this to the ./import folder next to compose.yaml.)
# IMPORT_DIR=./import

# BulkVS credentials: portal.bulkvs.com -> API -> API Credentials, under
# "REST API": API USERNAME and API PASSWORD/TOKEN (not your portal login).
# The "Basic Auth Header" and "Query API" token there are not needed.
# Leave BULKVS_USERNAME empty to run in mock mode: nothing is sent, and each
# outgoing message gets a fake auto-reply so you can try the UI.
BULKVS_USERNAME=
BULKVS_PASSWORD=
BULKVS_API_BASE=https://portal.bulkvs.com/api/v1.0

# A random string you make up. BulkVS has no field for it: it goes inside the
# webhook URL you paste into BulkVS as the "Message URL":
#   $PUBLIC_URL/webhook/bulkvs/$WEBHOOK_SECRET
# (Admin settings in the app shows the full URL to copy.)
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=

# Sign-in cookies are marked Secure automatically when TextBoss is reached over
# HTTPS (including through a reverse proxy) and left plain over http:// on your
# local network. Set to 1 to never mark them Secure.
# INSECURE_COOKIES=1

# Reverse proxies whose X-Forwarded-For header is trusted for the client IP
# (used by login throttling). Default: loopback and private networks.
# TRUST_PROXY=loopback, linklocal, uniquelocal
