{
  "name": "textboss",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-user, multi-number SMS/MMS web app for BulkVS",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "manual:screenshots": "node tools/manual/screenshots.mjs",
    "manual:demo": "node tools/manual/seed-demo.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "express": "^5.1.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "puppeteer": "^24.43.1"
  }
}
